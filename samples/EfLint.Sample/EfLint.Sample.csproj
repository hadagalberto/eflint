<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>EfLint.Sample</RootNamespace>
    <!-- The sample intentionally violates every implemented rule. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>false</MSBuildTreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS8618;CS0169;EF1002</NoWarn>
    <!-- Command-line -warnaserror is a global property; keep intentional sample diagnostics as warnings. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);EFL3001;EFL3002</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.11" />
    <ProjectReference Include="../../src/EfLint/EfLint.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
